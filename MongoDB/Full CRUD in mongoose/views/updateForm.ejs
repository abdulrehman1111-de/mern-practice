<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Student</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f3f4f6;
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            color: #1f2937;
        }

        form {
            width: 100%;
            max-width: 380px;
            margin: 16px;
            padding: 28px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        h2 {
            margin: 0 0 4px;
            font-size: 20px;
            font-weight: 600;
        }

        label {
            display: flex;
            flex-direction: column;
            gap: 6px;
            font-size: 13px;
            font-weight: 500;
            color: #4b5563;
        }

        input[type="text"] {
            padding: 10px 12px;
            font-size: 15px;
            color: #1f2937;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        input[type="text"]:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        button {
            margin-top: 6px;
            padding: 11px;
            font-size: 15px;
            font-weight: 500;
            color: #ffffff;
            background: #2563eb;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.15s;
        }

        button:hover {
            background: #1d4ed8;
        }
    </style>
</head>
<body>
    <form method="post" action="/ui/update/submit">
        <h2>Update student</h2>

        <input type="hidden" name="id" value="<%= user._id %>" id="">

        <label>Name
            <input type="text" name="name" value="<%= user.name %>" id="">
        </label>

        <label>Age
            <input type="text" name="age" value="<%= user.age %>" id="">
        </label>

        <label>Email
            <input type="text" name="email" value="<%= user.email %>" id="">
        </label>

        <button type="submit">Update student data</button>
    </form>
</body>
</html>