<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #f3f4f6;
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            color: #1f2937;
        }

        .card-box {
            max-width: 900px;
            margin: 40px auto;
            padding: 28px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
        }

        h1 {
            font-size: 20px;
            font-weight: 600;
            margin: 0 0 18px;
        }

        .top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }

        .top-bar h1 {
            margin: 0;
        }

        .add-btn {
            padding: 8px 14px;
            font-size: 14px;
            font-weight: 500;
            color: #ffffff;
            background: #2563eb;
            border-radius: 6px;
            text-decoration: none;
            transition: background 0.15s;
        }

        .add-btn:hover {
            background: #1d4ed8;
            color: #ffffff;
        }

        .table {
            margin-bottom: 0;
        }

        .table th {
            font-size: 13px;
            font-weight: 600;
            color: #4b5563;
            background: #f9fafb;
        }

        .table td {
            vertical-align: middle;
        }

        .action-link {
            display: inline-block;
            padding: 4px 12px;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            border-radius: 6px;
            transition: background 0.15s;
        }

        .action-link.update {
            color: #2563eb;
            border: 1px solid #2563eb;
        }

        .action-link.update:hover {
            background: #2563eb;
            color: #ffffff;
        }

        .action-link.delete {
            color: #dc2626;
            border: 1px solid #dc2626;
        }

        .action-link.delete:hover {
            background: #dc2626;
            color: #ffffff;
        }
    </style>
</head>
<body>

    <div class="card-box">
        <div class="top-bar">
            <h1>Student data</h1>
            <a class="add-btn" href="/form">Add student data</a>
        </div>

        <table class="table table-bordered table-hover table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Age</th>
                    <th>Email</th>
                    <th>Deletion</th>
                    <th>Updation</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                    <tr>
                        <td><%= user.name %></td>
                        <td><%= user.age %></td>
                        <td><%= user.email %></td>
                        <td><a class="action-link delete" href="/ui/delete/<%= user._id %>">Delete</a></td>
                        <td><a class="action-link update" href="/ui/update/<%= user._id %>">Update</a></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>